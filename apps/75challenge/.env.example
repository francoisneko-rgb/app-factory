# ============================================================
# App Factory — Template .env (copier en .env, puis remplir)
# Les services ne s'activent QUE si la clé correspondante est
# présente. Aucune clé = service désactivé (le template tourne
# sans aucun service).
# ============================================================

# --- Expo / EAS ---
# Token build cloud EAS (expo.dev → Settings → Access Tokens)
EXPO_TOKEN=

# --- Sentry (crashs) ---
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- PostHog (analytics) ---
EXPO_PUBLIC_POSTHOG_KEY=

# --- RevenueCat (monétisation) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Clerk (auth, si besoin) ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- API de démo (TanStack Query) ---
EXPO_PUBLIC_API_URL=https://jsonplaceholder.typicode.com