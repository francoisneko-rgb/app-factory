{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" }
    },
    "google": {
      "options": { "apiKey": "{env:GOOGLE_API_KEY}" }
    },
    "openrouter": {
      "options": { "apiKey": "{env:OPENROUTER_API_KEY}" }
    }
  },
  "disabled_providers": ["openrouter"],
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow"
  },
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "agent": {
    "kimi-k3": {
      "model": "opencode-go/kimi-k3",
      "description": "Raisonnement lourd, stratégie et planification complexe.",
      "mode": "subagent"
    },
    "qwen-coder": {
      "model": "qwen/qwen3-coder-480b-a35b-instruct",
      "description": "Génération et refactoring de code technique à bas coût.",
      "mode": "subagent"
    },
    "qwen-max": {
      "model": "qwen/qwen3-max",
      "description": "Raisonnement généraliste avancé.",
      "mode": "subagent"
    },
    "gemini-flash": {
      "model": "google/gemini-2.5-flash",
      "description": "Traitement ultra-rapide de données volumineuses.",
      "mode": "subagent"
    },
    "sonnet-quality": {
      "model": "anthropic/claude-sonnet-4-6",
      "description": "Revue critique et contrôle qualité final.",
      "mode": "subagent"
    }
  }
}