{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" }
    },
    "google": {
      "options": { "apiKey": "{env:GOOGLE_API_KEY}" }
    },
    "openrouter": {
      "options": { "apiKey": "{env:OPENROUTER_API_KEY}" }
    }
  },
  "permissions": {
    "command": "allow",
    "bash": "allow",
    "edit": "allow",
    "read": "allow"
  },
  "model": "openrouter/deepseek/deepseek-v4-flash-0731",
  "small_model": "openrouter/deepseek/deepseek-v4-flash-0731",
  "agent": {
    "kimi-k3": {
      "model": "openrouter/moonshotai/Kimi-K3",
      "description": "Raisonnement lourd, stratégie et planification complexe.",
      "mode": "subagent"
    },
    "qwen-coder": {
      "model": "openrouter/Qwen/Qwen3-Coder-480B-A35B-Instruct",
      "description": "Génération et refactoring de code technique à bas coût.",
      "mode": "subagent"
    },
    "qwen-max": {
      "model": "openrouter/Qwen/Qwen3-Max",
      "description": "Raisonnement généraliste avancé.",
      "mode": "subagent"
    },
    "gemini-flash": {
      "model": "openrouter/google/gemini-2.5-flash",
      "description": "Traitement ultra-rapide de données volumineuses.",
      "mode": "subagent"
    },
    "sonnet-quality": {
      "model": "openrouter/anthropic/claude-sonnet-4.6",
      "description": "Revue critique et contrôle qualité final.",
      "mode": "subagent"
    }
  }
}